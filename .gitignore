# ==========================================
# QUEBET AI - Comprehensive .gitignore
# ==========================================

# ------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
credentials.json
secrets.json

# ------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------
# Next.js & Frontend Build Outputs
# ------------------------------------------
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo

# ------------------------------------------
# Python & Virtual Environments
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------
# Testing, Coverage & Linters
# ------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.ruff_cache/
.mypy_cache/
.eslintcache

# ------------------------------------------
# Databases, Local Storage & Vector Stores
# ------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
pgdata/
redisdata/
neo4jdata/
chromadata/
chroma_data/
**/chroma_data/

# ------------------------------------------
# Logs
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# IDEs & Editor Metadata
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ------------------------------------------
# Operating System Artifacts
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
