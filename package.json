{
  "name": "quebet-ai-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "QUEBET AI — Industrial-Grade AI Copilot for Electronics Engineering",
  "workspaces": [
    "frontend",
    "admin",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:admin": "npm --prefix admin run dev",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --port 8000",
    "build:frontend": "npm --prefix frontend run build",
    "build:admin": "npm --prefix admin run build",
    "test:backend": "python -m pytest backend/tests"
  },
  "keywords": [
    "electronics",
    "ai-copilot",
    "pcb-design",
    "circuit-analysis",
    "openrouter",
    "fastapi",
    "nextjs"
  ],
  "author": "Quebet AI Team",
  "license": "Apache-2.0"
}
